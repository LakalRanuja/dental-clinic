<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="580.0" prefWidth="600.0" spacing="16.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.dental.clinic.view.UserRegisterView">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Users" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="addNewButton" onAction="#handleShowForm"
                        style="-fx-font-weight: bold; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6;"
                        text="Add new" />
            </children>
        </HBox>

        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Full Name">
                    <cellValueFactory>
                        <PropertyValueFactory property="fullName" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Username">
                    <cellValueFactory>
                        <PropertyValueFactory property="username" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Role">
                    <cellValueFactory>
                        <PropertyValueFactory property="role" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <VBox fx:id="formSection" managed="false" spacing="16.0"
              style="-fx-border-color: #e2e2e2; -fx-border-width: 1 0 0 0;" visible="false">
            <padding>
                <Insets top="16.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Register User" />

                <GridPane hgap="16.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <children>
                        <Label text="Full Name" GridPane.rowIndex="0" />
                        <TextField fx:id="fullNameField" maxWidth="Infinity" GridPane.columnIndex="1"
                                   GridPane.rowIndex="0" />

                        <Label text="Username" GridPane.rowIndex="1" />
                        <TextField fx:id="usernameField" maxWidth="Infinity" GridPane.columnIndex="1"
                                   GridPane.rowIndex="1" />

                        <Label text="Password" GridPane.rowIndex="2" />
                        <PasswordField fx:id="passwordField" maxWidth="Infinity" GridPane.columnIndex="1"
                                       GridPane.rowIndex="2" />

                        <Label text="Role" GridPane.rowIndex="3" />
                        <ComboBox fx:id="roleCombo" maxWidth="Infinity" promptText="Select a role"
                                  GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </children>
                </GridPane>

                <HBox spacing="12.0">
                    <children>
                        <Button fx:id="registerButton" onAction="#handleRegister" prefHeight="44.0"
                                prefWidth="180.0"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #0d9488; -fx-text-fill: white; -fx-background-radius: 8;"
                                text="Register User" />
                        <Button onAction="#handleCancelForm" prefHeight="44.0" prefWidth="180.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: red; -fx-text-fill: white; -fx-background-radius: 8;" text="Cancel" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
