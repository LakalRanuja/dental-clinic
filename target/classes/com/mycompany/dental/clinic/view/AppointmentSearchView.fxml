<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="560.0" spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.dental.clinic.view.AppointmentSearchView">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Find Appointment" />
        <Label style="-fx-text-fill: #666;" text="Search using the appointment number, e.g. APT-0001" />

        <HBox spacing="10.0">
            <children>
                <TextField fx:id="queryField" onAction="#handleSearch" prefWidth="260.0"
                           promptText="Enter appointment number" />
                <Button onAction="#handleSearch"
                        style="-fx-font-weight: bold; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6;"
                        text="Search" />
            </children>
        </HBox>

        <Label fx:id="statusLabel" managed="false" style="-fx-text-fill: #c0392b;" visible="false" />

        <GridPane fx:id="resultGrid" hgap="28.0" managed="false" vgap="10.0" visible="false">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;" text="Appointment No"
                       GridPane.rowIndex="0" />
                <Label fx:id="appointmentNumberValue" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;" text="Patient Name"
                       GridPane.rowIndex="1" />
                <Label fx:id="patientNameValue" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;" text="Address"
                       GridPane.rowIndex="2" />
                <Label fx:id="addressValue" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;" text="Contact Number"
                       GridPane.rowIndex="3" />
                <Label fx:id="contactNumberValue" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;" text="Dentist"
                       GridPane.rowIndex="4" />
                <Label fx:id="dentistNameValue" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;" text="Treatment Type"
                       GridPane.rowIndex="5" />
                <Label fx:id="treatmentTypeValue" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;"
                       text="Appointment Date" GridPane.rowIndex="6" />
                <Label fx:id="appointmentDateValue" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;"
                       text="Appointment Time" GridPane.rowIndex="7" />
                <Label fx:id="appointmentTimeValue" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;" text="Status"
                       GridPane.rowIndex="8" />
                <Label fx:id="statusValue" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #666; -fx-font-size: 11px;" text="Payment Status"
                       GridPane.rowIndex="9" />
                <Label fx:id="paymentStatusValue" GridPane.columnIndex="1" GridPane.rowIndex="9" />
            </children>
        </GridPane>
    </children>
</VBox>
