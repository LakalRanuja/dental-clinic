<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="620.0" prefWidth="640.0" spacing="16.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.dental.clinic.view.DentistRegisterView">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Dentists" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="addNewButton" onAction="#handleShowForm"
                        style="-fx-font-weight: bold; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6;"
                        text="Add new" />
            </children>
        </HBox>

        <TableView fx:id="dentistsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Name">
                    <cellValueFactory>
                        <PropertyValueFactory property="name" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Specialization">
                    <cellValueFactory>
                        <PropertyValueFactory property="specialization" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Contact Number">
                    <cellValueFactory>
                        <PropertyValueFactory property="contactNumber" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Consultation Fee">
                    <cellValueFactory>
                        <PropertyValueFactory property="consultationFee" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <VBox fx:id="formSection" managed="false" spacing="16.0"
              style="-fx-border-color: #e2e2e2; -fx-border-width: 1 0 0 0;" visible="false">
            <padding>
                <Insets top="16.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Register Dentist" />

                <GridPane hgap="16.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <children>
                        <Label text="Name" GridPane.rowIndex="0" />
                        <TextField fx:id="nameField" maxWidth="Infinity" GridPane.columnIndex="1"
                                   GridPane.rowIndex="0" />

                        <Label text="Specialization" GridPane.rowIndex="1" />
                        <ComboBox fx:id="specializationCombo" maxWidth="Infinity" promptText="Select a specialization"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Contact Number" GridPane.rowIndex="2" />
                        <TextField fx:id="contactNumberField" maxWidth="Infinity" GridPane.columnIndex="1"
                                   GridPane.rowIndex="2" />

                        <Label text="Consultation Fee" GridPane.rowIndex="3" />
                        <TextField fx:id="consultationFeeField" maxWidth="Infinity" promptText="e.g. 2500.00"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </children>
                </GridPane>

                <Label style="-fx-font-weight: bold;" text="Treatments this dentist can perform" />
                <ListView fx:id="treatmentsList" prefHeight="140.0" />

                <HBox spacing="12.0">
                    <children>
                        <Button fx:id="registerButton" onAction="#handleRegister" prefHeight="44.0"
                                prefWidth="180.0"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #0d9488; -fx-text-fill: white; -fx-background-radius: 8;"
                                text="Register Dentist" />
                        <Button onAction="#handleCancelForm" text="Cancel" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
