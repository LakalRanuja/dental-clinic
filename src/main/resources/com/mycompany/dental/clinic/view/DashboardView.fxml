<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.dental.clinic.view.DashboardView">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: white; -fx-border-color: #e2e2e2; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Dental Clinic" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="accountLabel" style="-fx-font-size: 13px; -fx-text-fill: #555;" />
                <Button onAction="#handleLogout" style="-fx-background-color: red; -fx-text-fill: white;"
                        text="Log out" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox fillWidth="true" spacing="24.0">
            <padding>
                <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
            </padding>
            <children>
                <Label fx:id="welcomeLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

                <HBox spacing="20.0">
                    <children>
                        <VBox minWidth="200.0" spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-width: 1 1 1 4; -fx-border-color: #e2e2e2 #e2e2e2 #e2e2e2 #2563eb;">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label fx:id="todaysAppointmentsValue"
                                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #666;" text="Today's Appointments" />
                            </children>
                        </VBox>
                        <VBox minWidth="200.0" spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-width: 1 1 1 4; -fx-border-color: #e2e2e2 #e2e2e2 #e2e2e2 #0d9488;">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label fx:id="totalAppointmentsValue"
                                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0d9488;" />
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #666;" text="Total Appointments" />
                            </children>
                        </VBox>
                        <VBox minWidth="200.0" spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-width: 1 1 1 4; -fx-border-color: #e2e2e2 #e2e2e2 #e2e2e2 #7c3aed;">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label fx:id="upcomingAppointmentsValue"
                                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;" />
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #666;" text="Upcoming Appointments" />
                            </children>
                        </VBox>
                        <VBox minWidth="200.0" spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-width: 1 1 1 4; -fx-border-color: #e2e2e2 #e2e2e2 #e2e2e2 #ea580c;">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label fx:id="totalPatientsValue"
                                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #ea580c;" />
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #666;" text="Total Patients" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="16.0">
                    <children>
                        <Button fx:id="registerAppointmentButton" onAction="#handleRegisterAppointment"
                                prefHeight="60.0" prefWidth="200.0"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #0d9488; -fx-text-fill: white; -fx-background-radius: 8;"
                                text="Register Appointment" />
                        <Button fx:id="searchAppointmentButton" onAction="#handleSearchAppointment"
                                prefHeight="60.0" prefWidth="200.0"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8;"
                                text="Search Appointment" />
                        <Button fx:id="addPatientButton" onAction="#handleRegisterPatient" prefHeight="60.0"
                                prefWidth="200.0"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #7c3aed; -fx-text-fill: white; -fx-background-radius: 8;"
                                text="Add Patient" />
                        <Button fx:id="addDentistButton" onAction="#handleRegisterDentist" prefHeight="60.0"
                                prefWidth="200.0"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #ea580c; -fx-text-fill: white; -fx-background-radius: 8;"
                                text="Add Dentist" />
                        <Button fx:id="addUserButton" onAction="#handleRegisterUser" prefHeight="60.0"
                                prefWidth="200.0"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #00004d; -fx-text-fill: white; -fx-background-radius: 8;"
                                text="Add User" />
                        <Button fx:id="paymentsButton" disable="true" prefHeight="60.0" prefWidth="200.0"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 8;"
                                text="Do Payments" />
                    </children>
                </HBox>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="All Appointments" />
                        <TableView fx:id="appointmentsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn text="Appointment No">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="appointmentNumber" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Patient ID">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="patientId" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Dentist">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="dentistName" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Treatment">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="treatmentType" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Date">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="appointmentDate" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Time">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="appointmentTime" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Booked By">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="bookedBy" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Status">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="status" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn text="Payment Status">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="paymentStatus" />
                                    </cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
